# Copiar este archivo a .env y completar los valores. .env está en .gitignore.

# UID del usuario que corre docker compose (Linux).
# Ejecutar: id -u
AIRFLOW_UID=50000

# Claves secretas de Airflow. Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__API__SECRET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=

# PostgreSQL
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
DATABASE_URL=postgresql+psycopg2://airflow:airflow@postgres:5432/featurestore

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:9090

# API
API_HOST=0.0.0.0
API_PORT=8000
