# Copy this file to .env and fill in real values. .env is gitignored.

# UID of the user running docker-compose (Linux). Used so mounted volumes are
# writable by the host user. On macOS/Windows any value works; 50000 is Airflow's default.
AIRFLOW_UID=50000

# Airflow admin bootstrap (only used on first start by airflow-init).
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=changeme

# Airflow secrets. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(16)).decode())"
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__API__SECRET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=

# PostgreSQL (airflow metadata db + featurestore + mlflow backend).
POSTGRES_USER=airflow
POSTGRES_PASSWORD=changeme

# Conexion al feature store (usado por dag_drift_report).
FEATURESTORE_DB_URL=postgresql+psycopg2://airflow:airflow@postgres:5432/featurestore

# Credenciales para que el DAG de drift dispare reentrenamiento via Airflow REST API.
AIRFLOW_API_URL=http://airflow-apiserver:8080/api/v2
AIRFLOW_API_USER=airflow
AIRFLOW_API_PASSWORD=changeme

# MLflow client config (used by Airflow tasks and MLflow server).
MLFLOW_TRACKING_URI=http://mlflow:9090
